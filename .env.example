# Required. Postgres connection string (Neon or any hosted Postgres).
DATABASE_URL=

# Required in production. Random string that signs auth sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Google OAuth client for the Search Console integration.
# Create at console.cloud.google.com > APIs & Services > Credentials.
# Authorized redirect URI: https://YOUR-DOMAIN/api/gsc/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. If set, Claude picks and polishes anchor text for top opportunities.
# Without it, LinkAgent still works using its built-in scoring.
ANTHROPIC_API_KEY=

# Optional. Model used for anchor selection. Defaults to claude-opus-5.
LINKAGENT_MODEL=claude-opus-5

# Optional. Max pages to crawl per site. Defaults to 200.
LINKAGENT_MAX_PAGES=200
